import java.util.*;\par
class palindrome\{\par
public static void main(String args[])\{\par
\tab Scanner sc = new Scanner(System.in);\par
\tab System.out.print("Enter number : ");\par
\tab int num = sc.nextInt();\par
\tab\par
\tab int n = num;\par
\tab int reverse = 0;\par
\tab\par
\tab while(n > 0)\{\par
\tab\tab int digit = n % 10;\par
\tab\tab reverse *= 10;\par
\tab\tab reverse += digit;\par
\tab\tab n /= 10;\par
\tab\}\par
\par
\tab if(reverse == num)\{\par
\tab\tab System.out.println("Number is Palindrome ");\par
\tab\}\par
\tab else\{\par
\tab\tab System.out.println("Number is Not Palindrome ");\par
\tab\}\par
\}\par
\}\par
