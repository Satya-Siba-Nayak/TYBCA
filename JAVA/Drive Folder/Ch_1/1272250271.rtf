import java.util.*;\par
class Q4\{\par
\par
public int BinToDec(String s)\{\par
\tab int num = 0;\par
\tab int Base = 1;\par
\tab int i = s.length()-1;\par
\tab while(i >= 0)\{\par
\tab\tab if(s.charAt(i) == '1')\{\par
\tab\tab\tab num += Base;\par
\tab\tab\}\par
\tab\tab Base *= 2;\par
\tab\tab i--;\par
\tab\}\par
\tab\par
\tab return num;\par
\tab\par
\}\par
\par
\par
public static void main(String[] args)\{\par
\tab Scanner sc = new Scanner(System.in); \par
\par
\tab Q4 obj = new Q4();\par
\tab System.out.println("Enter Binary Number : ");\par
\tab String num = sc.nextLine();\par
\tab System.out.println("Binary to Decimal : " + obj.BinToDec(num));\par
\tab\par
\tab\par
\}\par
