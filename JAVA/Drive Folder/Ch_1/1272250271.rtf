class Q3\{\par
\par
public void decToBinary(int num)\{\par
\par
\tab int[] arr = new int[10];\par
\tab int cnt = 0;\par
\tab while(num > 0)\{\par
\tab\tab int rem = num % 2;\par
\tab\tab arr[cnt] = rem;\par
\tab\tab num /= 2;\par
\tab\tab cnt++;\par
\tab\}\par
\tab\par
\tab for(int i = cnt-1; i >=0; i--)\{\par
\tab\tab System.out.print(arr[i]);\par
\tab\}\par
\tab\par
\}\par
\par
\par
